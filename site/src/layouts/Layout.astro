---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/libre-franklin/index.css';
import '../styles/global.css';
import meta from '../generated/meta.json';
import { sitePath } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
const nav = [
  ['/', 'Story'],
  ['/who-is-behind/', 'Investigation'],
  ['/arenas/', 'Arenas'],
  ['/taxes/', 'Taxes'],
  ['/tax-breaks/', 'Tax breaks'],
  ['/threats/', 'Threats'],
  ['/leases/', 'Leases'],
  ['/households/', 'Households'],
  ['/sources/', 'Sources'],
  ['/fact-check/', 'Fact check'],
];
const canonical = new URL(sitePath(path), Astro.site).href;
const asOf = new Date(meta.as_of + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='7' fill='%232a78d6'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the story</a>
    <header class="masthead">
      <div class="masthead-inner">
        <a class="site-name" href={sitePath('/')}>Who Paid for the NBA's Arenas</a>
        <nav class="site-nav" aria-label="Pages">
          {nav.map(([href, label]) => <a href={sitePath(href)} aria-current={href === path ? 'page' : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="col">
        <p class="foot-name">Who Paid for the NBA's Arenas</p>
        Ledger as of {asOf}. Dollars are 2026 dollars (BLS CPI-U) unless marked. Every number links to its entry in
        the <a href={sitePath('/fact-check/')}>fact-check ledger</a>, which also lists each paragraph's sources; every chapter
        and chart names its own. The data and the code that builds this site are in the <a
        href="https://github.com/realvivek/NBA-Arena-Funding">project repository</a>.
      </div>
    </footer>
    <div class="tip" role="status" hidden></div>
    <script is:inline>
      // Tooltips for chart marks. Optional: every value is also in the chart's data table.
      (function () {
        var tip = document.querySelector('.tip');
        if (!tip) return;
        function show(el, x, y) {
          tip.textContent = el.getAttribute('data-tip');
          tip.hidden = false;
          var r = tip.getBoundingClientRect();
          var left = Math.min(Math.max(8, x + 12), window.innerWidth - r.width - 8);
          var top = y - r.height - 12 < 8 ? y + 16 : y - r.height - 12;
          tip.style.left = left + 'px';
          tip.style.top = top + 'px';
        }
        document.addEventListener('pointermove', function (e) {
          var el = e.target instanceof Element ? e.target.closest('[data-tip]') : null;
          if (el) show(el, e.clientX, e.clientY);
          else tip.hidden = true;
        });
        document.addEventListener('focusin', function (e) {
          var el = e.target instanceof Element ? e.target.closest('[data-tip]') : null;
          if (!el) return;
          var r = el.getBoundingClientRect();
          show(el, r.left + r.width / 2, r.top);
        });
        document.addEventListener('focusout', function () { tip.hidden = true; });
        window.addEventListener('scroll', function () { tip.hidden = true; }, { passive: true });
      })();
      // Scroll-driven figures: the step the reader has scrolled to sets the chart's state. Without this script the
      // chart rests in its last state and every step reads as a paragraph.
      (function () {
        document.querySelectorAll('figure.scrolly').forEach(function (fig) {
          var steps = Array.prototype.slice.call(fig.querySelectorAll('.step'));
          if (!steps.length) return;
          var cards = steps.map(function (s) { return s.querySelector('.step-card') || s; });
          var plot = fig.querySelector('.scrolly-plot'), box = fig.querySelector('.scrolly-sticky');
          fig.classList.add('js');
          var phone = window.matchMedia('(max-width: 63.99rem)');
          var current = null, queued = false, cardTop = 0;
          function activate(el) {
            steps.forEach(function (s) { s.classList.toggle('is-active', s === el); });
            fig.setAttribute('data-step', el.getAttribute('data-step'));
          }
          function shown() {
            var plots = Array.prototype.slice.call(box.querySelectorAll('.plot'));
            return plots.filter(function (p) { return p.offsetHeight > 0; })[0] || null;
          }
          // Fit the chart to the screen. On wide screens the chart and its title hold the middle of the screen,
          // scaled to fit its height. On phones the chart holds the top, and each step's card sits just under it.
          function measure() {
            var vh = window.innerHeight, p = shown();
            if (phone.matches) {
              fig.style.removeProperty('--plot-top');
              fig.style.removeProperty('--plot-chrome');
              cardTop = Math.round(box.getBoundingClientRect().height) + 10;
              fig.style.setProperty('--card-top', cardTop + 'px');
            } else {
              fig.style.removeProperty('--card-top');
              var chrome = plot.offsetHeight - (p ? p.offsetHeight : 0);
              fig.style.setProperty('--plot-chrome', Math.round(chrome + 32) + 'px');
              fig.style.setProperty('--plot-top', Math.max(12, Math.round((vh - plot.offsetHeight) / 2)) + 'px');
            }
            queue();
          }
          // The active step: on wide screens, the last one whose top has passed 60 percent of the way down the
          // screen. On phones, the next step takes over just before the card above it would be pushed up over
          // the chart, so that card has faded out by then. A jump (a link, a key, a fast fling) lands on the
          // right state either way.
          function update() {
            queued = false;
            var el = steps[0], k;
            if (phone.matches) {
              for (k = 1; k < steps.length; k++)
                if (steps[k].getBoundingClientRect().top < cardTop + cards[k - 1].offsetHeight + 16) el = steps[k];
              // past the last step the chart scrolls away; its card fades first rather than slide over it
              k = steps.length - 1;
              fig.classList.toggle('is-done', steps[k].getBoundingClientRect().bottom < cardTop + cards[k].offsetHeight + 16);
            } else {
              fig.classList.remove('is-done');
              var line = window.innerHeight * 0.6;
              for (k = 0; k < steps.length; k++) if (steps[k].getBoundingClientRect().top < line) el = steps[k];
            }
            if (el !== current) { current = el; activate(el); }
          }
          function queue() {
            if (!queued) { queued = true; requestAnimationFrame(update); }
          }
          measure();
          requestAnimationFrame(function () { requestAnimationFrame(function () { fig.classList.add('ready'); }); });
          window.addEventListener('scroll', queue, { passive: true });
          window.addEventListener('resize', measure);
          // the typefaces load after the first layout and change the title's and the cards' heights
          if (window.ResizeObserver) new ResizeObserver(function () { measure(); }).observe(box);
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
        });
      })();
      // Reading progress on the story: a line under the masthead fills as the reader goes through it, with a tick
      // where each chapter begins. Without this script the line stays hidden.
      (function () {
        var bar = document.querySelector('.progress'), story = document.querySelector('.story');
        if (!bar || !story) return;
        var fill = bar.querySelector('.progress-fill'), marks = bar.querySelector('.progress-marks');
        var chapters = Array.prototype.slice.call(story.querySelectorAll('.chapter'));
        var start = 0, end = 1, queued = false;
        function update() {
          queued = false;
          var p = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
          fill.style.transform = 'scaleX(' + p.toFixed(4) + ')';
        }
        function measure() {
          start = story.getBoundingClientRect().top + window.scrollY;
          end = Math.max(start + 1, start + story.offsetHeight - window.innerHeight);
          marks.textContent = '';
          chapters.forEach(function (c) {
            var at = (c.getBoundingClientRect().top + window.scrollY - start) / (end - start);
            if (at <= 0 || at >= 1) return;
            var m = document.createElement('i');
            m.style.left = (100 * at).toFixed(2) + '%';
            marks.appendChild(m);
          });
          update();
        }
        bar.hidden = false;
        measure();
        window.addEventListener('scroll', function () { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
        window.addEventListener('resize', measure);
        // opening a team's record or the notes under a chart changes the story's height
        if (window.ResizeObserver) new ResizeObserver(measure).observe(story);
      })();
      // Every team, ranked: the buttons reorder the rows, and the list shows the first ten until the reader asks for
      // all of them (or follows a link to a team further down). Without this script every row shows, in order of
      // public money.
      (function () {
        document.querySelectorAll('.teams').forEach(function (box) {
          var bar = box.querySelector('.teams-sort'), list = box.querySelector('.teams-list');
          if (!bar || !list) return;
          bar.hidden = false;
          var more = box.querySelector('.teams-more'), target = null;
          try { target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null; } catch (e) {}
          if (more && !(target && list.contains(target))) {
            box.classList.add('collapsed');
            more.hidden = false;
            more.addEventListener('click', function () { box.classList.remove('collapsed'); more.hidden = true; });
          }
          var rows = Array.prototype.slice.call(list.children);
          bar.addEventListener('click', function (e) {
            var b = e.target instanceof Element ? e.target.closest('button[data-sort]') : null;
            if (!b) return;
            var k = b.getAttribute('data-sort');
            rows.sort(function (p, q) {
              if (k === 'name') return p.dataset.name.localeCompare(q.dataset.name);
              return parseFloat(q.dataset[k]) - parseFloat(p.dataset[k]) || p.dataset.name.localeCompare(q.dataset.name);
            });
            rows.forEach(function (r, i) { r.querySelector('.tm-rank').textContent = String(i + 1); list.appendChild(r); });
            bar.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
          });
        });
      })();
      // The ZIP lookup: the form appears, and the ZIP code data loads the first time a reader uses it. Without this
      // script the form stays hidden and a link leads to every deal per household.
      (function () {
        var box = document.querySelector('.ziplookup');
        if (!box || !window.fetch) return;
        var form = box.querySelector('.zl-form'), input = box.querySelector('.zl-input'), out = box.querySelector('.zl-out');
        var loading = null;
        form.hidden = false;
        function load() {
          if (!loading) loading = fetch(box.getAttribute('data-src')).then(function (r) {
            if (!r.ok) throw new Error(String(r.status));
            return r.json();
          });
          return loading;
        }
        input.addEventListener('focus', function () { load().catch(function () { loading = null; }); });
        function usd(v) { return '$' + Math.round(v).toLocaleString('en-US'); }
        function add(parent, tag, cls, text) {
          var e = document.createElement(tag);
          if (cls) e.className = cls;
          if (text != null) e.textContent = text;
          parent.appendChild(e);
          return e;
        }
        function show(d, zip) {
          out.textContent = '';
          var card = add(out, 'div', 'zl-card');
          add(card, 'p', 'zl-zip', 'ZIP code ' + zip);
          var hits = (d.z[zip] || []).map(function (i) { return { g: d.g[i < 0 ? -i - 1 : i], part: i < 0 }; })
            .sort(function (a, b) { return a.g.l - b.g.l; });
          var total = 0, partial = false, lines = 0;
          if (!hits.length) {
            add(card, 'p', 'zl-none', 'No city, county or state that includes this ZIP code has put money into an NBA arena in this ledger.');
          } else {
            var list = add(card, 'ul', 'zl-lines');
            hits.forEach(function (h) {
              h.g.d.forEach(function (deal) {
                var li = add(list, 'li', 'zl-line');
                add(li, 'span', 'zl-amt', usd(deal.p));
                var what = add(li, 'span', 'zl-what');
                add(what, 'strong', null, h.g.j);
                what.appendChild(document.createTextNode(': ' + deal.t + ', ' + deal.a + (deal.n ? ' (' + deal.n + ')' : '') + '.' +
                  (h.part ? ' Only part of this ZIP code is in ' + h.g.j + '.' : '')));
                total += deal.p;
                partial = partial || h.part;
                lines += 1;
              });
            });
            if (lines > 1) {
              var tl = add(card, 'p', 'zl-total');
              add(tl, 'span', 'zl-amt', usd(total));
              add(tl, 'span', 'zl-what', partial ? 'In all, at most, per household' : 'In all, per household');
            }
          }
          add(card, 'p', 'zl-fed', 'Like every household in the country, yours also carries about ' + usd(d.fed) +
            ' of the federal income tax forgone on tax-exempt bonds for NBA arenas.');
          add(card, 'p', 'zl-note', 'Public money per household in 2026 dollars, over the life of each deal: a measure of scale, not a yearly bill.');
        }
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var zip = (input.value || '').replace(/[^0-9]/g, '');
          if (zip.length !== 5) { out.textContent = 'Enter a ZIP code, like 73102.'; return; }
          out.textContent = 'Looking up ' + zip + '...';
          load().then(function (d) { show(d, zip); }).catch(function () {
            loading = null;
            out.textContent = 'The ZIP code data did not load. Every deal is on the households page.';
          });
        });
      })();
    </script>
  </body>
</html>
