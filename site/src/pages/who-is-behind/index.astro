---
/**
 * The investigation, short: the funds and owners from finance in the teams, the people around the arena deals,
 * the reporting, the federal layer and what would change the math, as key figures, cards and charts. Its copy is
 * the who-is-behind entry in pages.yaml; the full text is at ./report/.
 */
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Blocks from '../../components/Blocks.astro';
import SourceList from '../../components/SourceList.astro';
import { referencePage } from '../../lib/page';
import { sitePath } from '../../lib/paths';

const { page, cites, blocks, title } = await referencePage('who-is-behind');
---
<Layout title={title} description={page.description} path="/who-is-behind/">
  <article class="ref brief">
    <PageHead page={page} id="who-is-behind" cites={cites} />
    <div class="col prose">
      <Blocks blocks={blocks} />
      <a class="cta" href={sitePath('/who-is-behind/report/')}>
        <span class="cta-k">The full report</span>
        <span class="cta-t">Every finding in detail: the funds and owners, lobbying and campaigns, studies and banks, the
          prize-winning reporting, federal tax breaks and remedies, each figure labeled and sourced.</span>
        <span class="cta-go">Read it →</span>
      </a>
      <h2 id="sources">Sources</h2>
      <details class="all-sources">
        <summary>All {cites.order.length} documents cited on this page</summary>
        <SourceList ids={cites.order} numbered />
      </details>
    </div>
  </article>
</Layout>
