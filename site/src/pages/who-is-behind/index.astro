---
/**
 * The investigation report (report/who-is-behind-nba-arena-deals.md, copied into src/generated by the pipeline),
 * rendered in the site's frame: the page head from pages.yaml, a list of the report's parts, then the report
 * itself. Its figures carry their labels and links inline, so they are not tokens; the copy rules for the story
 * do not apply, but the page is held to the same checks as every other (no dashes, headings, phone width).
 */
import { marked } from 'marked';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import { referencePage } from '../../lib/page';
import report from '../../generated/who-is-behind.md?raw';

const { page, cites, title } = await referencePage('who-is-behind');
const slug = (t: string) => t.toLowerCase().replace(/<[^>]+>/g, '').replace(/&[a-z#0-9]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// the report's own title stands in the repository file; here the page head carries the h1, so the body starts
// with the report's opening paragraph
const body = report.replace(/^# [^\n]*\n+/, '');
const words = body.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').split(/\s+/).filter(Boolean).length;
const minutes = Math.round(words / 230 / 5) * 5;
const parts: { id: string; text: string }[] = [];
const html = (marked.parse(body, { async: false }) as string)
  // headings get anchors, and the report's parts are listed at the top
  .replace(/<h([23])>(.*?)<\/h\1>/g, (_, level: string, text: string) => {
    const id = slug(text);
    const plain = text.replace(/<[^>]+>/g, '').replace(/&#39;/g, "'").replace(/&quot;/g, '"').replace(/&amp;/g, '&');
    if (level === '2') parts.push({ id, text: plain });
    return `<h${level} id="${id}">${text}</h${level}>`;
  })
  // tables stack into labeled lines on phones, like every table on the site: each cell carries its column's
  // name, and its content sits in one span so the label and the text form two columns
  .replace(/<table>([\s\S]*?)<\/table>/g, (_, inner: string) => {
    const heads = [...inner.matchAll(/<th[^>]*>([\s\S]*?)<\/th>/g)].map((m) => m[1].replace(/<[^>]+>/g, '').trim());
    const rows = inner.replace(/<tr>([\s\S]*?)<\/tr>/g, (row: string) => {
      let i = 0;
      return row.replace(/<td([^>]*)>([\s\S]*?)<\/td>/g, (_m: string, attrs: string, cell: string) =>
        `<td${attrs} data-label="${(heads[i++] ?? '').replace(/"/g, '&quot;')}"><span>${cell}</span></td>`);
    });
    return `<div class="table-wrap report-table"><table class="stack">${rows}</table></div>`;
  })
  .replace(/<a href="(https?:[^"]+)"/g, '<a href="$1" rel="noopener"');
---
<Layout title={title} description={page.description} path="/who-is-behind/">
  <article class="ref report">
    <PageHead page={page} id="who-is-behind" cites={cites} />
    <div class="col">
      <p class="note">
        About {minutes} minutes to read. Every figure carries a label: (a) computed, (b) taken from a primary
        document, (c) taken from the press or another secondary source; "unverified" marks an item seen only in
        search results. Status as of October 18, 2026. The report is kept in the repository as{' '}
        <a href="https://github.com/realvivek/NBA-Arena-Funding/blob/main/report/who-is-behind-nba-arena-deals.md">report/who-is-behind-nba-arena-deals.md</a>.
      </p>
      <nav class="report-parts" aria-label="Parts of the report">
        <p class="note">In this report</p>
        <ol>
          {parts.map((p) => <li><a href={`#${p.id}`}>{p.text}</a></li>)}
        </ol>
      </nav>
    </div>
    <div class="col prose report-body" set:html={html} />
  </article>
</Layout>
