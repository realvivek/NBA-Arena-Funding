---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Blocks from '../components/Blocks.astro';
import SourceLine from '../components/SourceLine.astro';
import SourceList from '../components/SourceList.astro';
import { Citations } from '../lib/sources';
import { paragraph } from '../lib/content';
import { prepare, textSources, type Prepared } from '../lib/prepare';
import { plain } from '../lib/copy';
import { sitePath } from '../lib/paths';
import meta from '../generated/meta.json';

const ORDER = ['who-is-behind', 'arenas', 'taxes', 'tax-breaks', 'threats', 'leases', 'households', 'sources', 'fact-check'];
const cites = new Citations();
const page = (await getEntry('pages', 'home'))!.data;
const pages = await getCollection('pages');
const pagePath = Object.fromEntries(pages.map((p) => [p.id, p.data.path]));
const sections = (await getCollection('story')).sort((a, b) => a.data.n - b.data.n);
const refs = pages.filter((p) => ORDER.includes(p.id)).sort((a, b) => ORDER.indexOf(a.id) - ORDER.indexOf(b.id));
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// The story reads like a newspaper's: a headline and deck, the lead graphic and its steps, then each chapter as
// short paragraphs and charts. The paragraphs carry no citation marks; each chapter ends with a line naming its
// sources, every chart names its own, and the fact-check page lists each paragraph's. Everything is prepared here
// in reading order, so the numbered list at the end follows the story.
const title = plain(page.title, { where: 'home title' });
const headline = paragraph(page.title, page.sources, 'home headline', cites, { link: false });
const deck = paragraph(page.deck, page.sources, 'home deck', cites);

// Key findings, under the head: each links to the section that holds it, a chapter by its heading or the
// opening by its lead graphic
const leadFigure = (blocks: (typeof sections)[number]['data']['blocks']) => {
  for (const b of blocks) if ('scrolly' in b || 'fig' in b) return 'scrolly' in b ? b.scrolly : b.fig;
};
const findings: { html: string; href: string; label: string }[] = [];
for (const [i, f] of page.findings.entries()) {
  const where = `home finding ${i + 1}`;
  const s = sections.find((x) => x.id === f.to);
  if (!s) throw new Error(`${where}: unknown story section ${f.to}`);
  const fig = s.data.title ? undefined : leadFigure(s.data.blocks);
  if (!s.data.title && !fig) throw new Error(`${where}: section ${f.to} has neither a title nor a chart to link to`);
  const label = s.data.title
    ? plain(s.data.title, { where: `${where} link` })
    : plain((await getEntry('figures', fig!))!.data.title, { where: `${where} link` });
  const { html } = paragraph(f.p, f.sources, where, cites);
  findings.push({ html, href: s.data.title ? `#${slug(s.data.title)}` : `#fig-${fig}`, label });
}
const [opening, ...rest] = sections;
if (opening.data.title) throw new Error('the story opens with its lead graphic, without a chapter title');
const openBlocks = await prepare(opening.data.blocks, cites, `story ${opening.id}`);
const chapters: { id: string; title: string; slug: string; blocks: Prepared[]; more: { href: string; text: string }[] }[] = [];
for (const s of rest) {
  if (!s.data.title) throw new Error(`story ${s.id}: a chapter needs a title`);
  const more = s.data.more.map((m) => {
    if (!pagePath[m.page]) throw new Error(`story ${s.id}: unknown page ${m.page}`);
    return { href: sitePath(pagePath[m.page]), text: plain(m.text, { where: `story ${s.id} link` }) };
  });
  chapters.push({ id: s.id, title: plain(s.data.title, { where: `story ${s.id} title` }), slug: slug(s.data.title), blocks: await prepare(s.data.blocks, cites, `story ${s.id}`), more });
}

// reading time, from the words a reader meets
const strip = (h: string) => h.replace(/<[^>]+>/g, ' ');
const text = [...findings.map((f) => f.html), ...[...openBlocks, ...chapters.flatMap((c) => c.blocks)]
  .flatMap((b) =>
    b.kind === 'p' || b.kind === 'quote' ? [b.html] :
    b.kind === 'scrolly' ? b.steps.map((s) => s.html) :
    b.kind === 'reveal' ? [b.lead, b.value] :
    b.kind === 'stats' ? b.tiles.flatMap((t) => [t.value, t.label]) :
    b.kind === 'cards' ? b.cards.flatMap((c) => [c.title, c.value ?? '', c.text]) : [])]
  .map(strip)
  .join(' ');
const minutes = Math.max(1, Math.round(text.split(/\s+/).filter(Boolean).length / 230));
const asOf = new Date(meta.as_of + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Layout title={title} description={page.description} path="/">
  <article class="story">
    <div class="progress" aria-hidden="true" hidden><span class="progress-fill"></span><span class="progress-marks"></span></div>
    <svg class="hero-court" viewBox="0 0 300 500" aria-hidden="true" focusable="false">
      <rect class="paint" x="110" y="170" width="190" height="160" />
      <path d="M300,170H110V330H300M110,190A60,60 0 0 0 110,310M300,30H158A237.5,237.5 0 0 0 158,470H300M260,210H247.5A40,40 0 0 0 247.5,290H260M260,220V280" />
      <path class="dash" d="M110,190A60,60 0 0 1 110,310" />
      <circle cx="247.5" cy="250" r="7.5" />
    </svg>
    <header class="hero">
      <p class="kicker">{page.kicker}</p>
      <h1 set:html={headline.html} />
      <p class="deck" set:html={deck.html} />
      <p class="dateline">
        <span>Data through <time datetime={meta.as_of}>{asOf}</time></span>
        <span>Dollars in 2026 terms</span>
        <span>{minutes} minute read</span>
      </p>
    </header>
    {findings.length > 0 && (
      <section class="findings" aria-labelledby="key-findings">
        <h2 id="key-findings">Key findings</h2>
        <ul>
          {findings.map((f) => (
            <li>
              <Fragment set:html={f.html} />{'\u00a0'}<a class="find-go" href={f.href} aria-label={`Read more: ${f.label}`} title={f.label}><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 2v7.5M2.75 6.5 6 9.75 9.25 6.5" /></svg></a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class="col prose opening">
      <Blocks blocks={openBlocks} level={3} quiet />
    </div>
    <div class="col prose">
      {chapters.map((c) => (
        <section class="chapter" aria-labelledby={c.slug}>
          <svg class="ch-court" aria-hidden="true" focusable="false"><line x1="0" x2="100%" y1="50%" y2="50%" /><circle cx="50%" cy="50%" r="20" /></svg>
          <header class="ch-head">
            <h2 id={c.slug}>{c.title}</h2>
          </header>
          <Blocks blocks={c.blocks} level={3} quiet />
          <SourceLine ids={textSources(c.blocks)} />
          {c.more.length > 0 && (
            <p class="chapter-more">
              {c.more.map((m) => <a href={m.href}>{m.text} →</a>)}
            </p>
          )}
        </section>
      ))}
    </div>
    <div class="col endmatter">
      <svg class="ch-court" aria-hidden="true" focusable="false"><line x1="0" x2="100%" y1="50%" y2="50%" /><circle cx="50%" cy="50%" r="20" /></svg>
      <h2 id="the-full-record">The full record</h2>
      <ul class="cards">
        {refs.map((r) => (
          <li class="card">
            <a href={sitePath(r.data.path)}>
              <span class="card-title" set:html={paragraph(r.data.title, r.data.sources, `card ${r.id} title`).html.replace(/<a [^>]*>|<\/a>/g, '')} />
              <span class="card-text">{plain(r.data.description, { where: `card ${r.id} text` })}</span>
            </a>
          </li>
        ))}
      </ul>
      <h2 id="sources-for-this-story">Sources for this story</h2>
      <details class="all-sources">
        <summary>All {cites.order.length} documents, in the order the story first cites them</summary>
        <SourceList ids={cites.order} numbered />
      </details>
    </div>
  </article>
</Layout>
