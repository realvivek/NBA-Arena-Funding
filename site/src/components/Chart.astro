---
/** A chart by figure id: its component, its dataset and its data table, drawn wide and narrow inside a Figure. */
import { getEntry } from 'astro:content';
import Figure from './Figure.astro';
import Bill from './charts/Bill.svelte';
import Values from './charts/Values.svelte';
import ValueTrend from './charts/ValueTrend.svelte';
import Owners from './charts/Owners.svelte';
import Rebuild from './charts/Rebuild.svelte';
import Arenas from './charts/Arenas.svelte';
import ArenaMap from './charts/ArenaMap.svelte';
import Takeovers from './charts/Takeovers.svelte';
import WhoPays from './charts/WhoPays.svelte';
import Households from './charts/Households.svelte';
import UnitedCenter from './charts/UnitedCenter.svelte';
import Ongoing from './charts/Ongoing.svelte';
import Threats from './charts/Threats.svelte';
import Leases from './charts/Leases.svelte';
import Columns from './charts/Columns.svelte';
import PayerShift from './charts/PayerShift.svelte';
import ValueGroups from './charts/ValueGroups.svelte';
import Incidence from './charts/Incidence.svelte';
import PropB from './charts/PropB.svelte';
import { dataset } from '../lib/data';
import * as T from '../lib/tables';
import { plain } from '../lib/copy';
import { ALLOW } from '../lib/content';
import { FIG_DATA } from '../lib/figures';
import type { PreparedStep } from '../lib/prepare';

interface Props {
  id: string;
  numbers?: number[];
  steps?: PreparedStep[];
  quiet?: boolean;
}
const { id, numbers = [], steps = [], quiet = false } = Astro.props;
const XWIDE = new Set<string>();
const REG: Record<string, { C: any; data: string; table: (rows: any[]) => any; props?: Record<string, unknown> }> = {
  bill: { C: Bill, data: 'public-layers', table: T.billTable },
  values: { C: Values, data: 'team-values', table: T.valuesTable },
  trend: { C: ValueTrend, data: 'value-history', table: T.trendTable },
  owners: { C: Owners, data: 'ownership', table: T.ownersTable },
  rebuild: { C: Rebuild, data: 'rebuild-by-year', table: T.rebuildTable },
  arenas: { C: Arenas, data: 'arenas', table: T.arenasTable },
  map: { C: ArenaMap, data: 'arena-map', table: T.mapTable },
  takeovers: { C: Takeovers, data: 'takeovers', table: T.takeoversTable },
  whopays: { C: WhoPays, data: 'who-pays', table: T.whoPaysTable },
  payershift: { C: PayerShift, data: 'payer-periods', table: T.payerShiftTable },
  valuegroups: { C: ValueGroups, data: 'team-values', table: T.valueGroupsTable },
  households: { C: Households, data: 'households-local', table: T.householdsTable },
  uc: { C: UnitedCenter, data: 'uc-bills', table: T.ucTable },
  ongoing: { C: Ongoing, data: 'ongoing', table: T.ongoingTable },
  threats: { C: Threats, data: 'threats', table: T.threatsTable, props: { deals: dataset('threat-deals').rows } },
  leases: { C: Leases, data: 'leases', table: T.leasesTable },
  slc: { C: Columns, data: 'slc-monthly', table: T.slcTable, props: { kind: 'slc' } },
  wcd: { C: Columns, data: 'wcd-annual', table: T.wcdTable, props: { kind: 'wcd' } },
  incidence: { C: Incidence, data: 'incidence', table: T.incidenceTable },
  propb: { C: PropB, data: 'propb-fifths', table: T.propbTable, props: { precincts: dataset('propb-precincts').rows, map: dataset('bexar-map').rows } },
};
const spec = REG[id];
if (!spec) throw new Error(`no chart registered for figure ${id}`);
if (spec.data !== FIG_DATA[id]) throw new Error(`figure ${id}: dataset mismatch`);
const ds = dataset(spec.data);
const fig = await getEntry('figures', id);
if (!fig) throw new Error(`figure ${id} is not in src/content/figures.yaml`);
const label = plain(fig.data.title, { where: `figure ${id} label`, sources: ds.sources, allow: ALLOW });
const C = spec.C;
---
<Figure id={id} dataset={ds} table={spec.table(ds.rows)} numbers={numbers} steps={steps} xwide={XWIDE.has(id)} quiet={quiet}>
  <C slot="wide" rows={ds.rows} variant="wide" label={label} {...spec.props} />
  <C slot="narrow" rows={ds.rows} variant="narrow" label={label} {...spec.props} />
</Figure>
