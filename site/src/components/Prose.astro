---
import Cites from './Cites.astro';
interface Props {
  html: string;
  sources: string[];
  numbers: number[];
}
const { html, sources, numbers } = Astro.props;
// A div, not a p: the citation toggle is a <details>, which a paragraph cannot contain.
---
<div class="para"><Fragment set:html={html} />{' '}<Cites ids={sources} numbers={numbers} /></div>
