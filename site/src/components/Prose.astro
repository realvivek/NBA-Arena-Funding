---
import Cites from './Cites.astro';
import { paragraph } from '../lib/content';
import type { Citations } from '../lib/sources';
interface Props {
  text: string;
  sources?: ({ id: string } | string)[];
  where: string;
  cites?: Citations;
}
const { text, sources = [], where, cites } = Astro.props;
// A div, not a p: the citation toggle is a <details>, which a paragraph cannot contain.
const { html, sources: all, numbers } = paragraph(text, sources, where, cites);
---
<div class="para"><Fragment set:html={html} />{' '}<Cites ids={all} numbers={numbers} /></div>
