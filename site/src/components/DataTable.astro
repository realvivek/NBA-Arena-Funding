---
import { source, shortName } from '../lib/sources';
export type Cell = string | number | null | undefined | { text: string; href: string } | { sources: string[] } | { label: string };
export interface Column {
  key: string;
  label: string;
  num?: boolean;
}
interface Props {
  columns: Column[];
  rows: Record<string, Cell>[];
  caption?: string;
  id?: string;
}
const { columns, rows, caption, id } = Astro.props;
const isObj = (c: Cell): c is Exclude<Cell, string | number | null | undefined> => typeof c === 'object' && c !== null;
---
<div class="table-wrap">
  <table id={id} class="stack">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>{columns.map((c) => <th scope="col" class={c.num ? 'n' : undefined}>{c.label}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr id={typeof r.__id === 'string' ? r.__id : undefined}>
          {columns.map((c) => {
            const v = r[c.key];
            if (isObj(v) && 'sources' in v)
              return (
                <td class="src-links" data-label={c.label}>
                  <span>
                    {v.sources.map((sid, i) => {
                      const s = source(sid);
                      return (
                        <>
                          {i > 0 && '; '}
                          <a href={s.url} rel="noopener" title={s.title}>{shortName(s)}</a>
                        </>
                      );
                    })}
                  </span>
                </td>
              );
            if (isObj(v) && 'href' in v) return <td data-label={c.label}><span><a href={v.href}>{v.text}</a></span></td>;
            if (isObj(v) && 'label' in v) return <td data-label={c.label}><span><span class="label">{v.label}</span></span></td>;
            return <td class={c.num ? 'n' : undefined} data-label={c.label}>{v === null || v === undefined || v === '' ? '' : <span>{v}</span>}</td>;
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
