---
/** A set of cards: a place or a claim, an optional number in large type, a short verdict or key figure, and a
 * sentence or two with its sources. */
import Cites from './Cites.astro';
import type { PreparedCard } from '../lib/prepare';
interface Props {
  cards: PreparedCard[];
  quiet?: boolean;
}
const { cards, quiet = false } = Astro.props;
---
<ul class="cardset">
  {cards.map((c) => (
    <li class="cardset-item">
      <p class="cs-title">{c.title}</p>
      {c.stat && <p class="cs-stat" set:html={c.stat} />}
      {c.value && <p class="cs-value" set:html={c.value} />}
      <div class="cs-text"><Fragment set:html={c.text} />{!quiet && <>{' '}<Cites ids={c.sources} numbers={c.numbers} /></>}</div>
    </li>
  ))}
</ul>
