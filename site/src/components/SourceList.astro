---
import { source, ORIGIN_LABEL, ORIGIN_ORDER } from '../lib/sources';
interface Props {
  ids: string[];
  numbered?: boolean;
  start?: number;
  group?: boolean;
  level?: 2 | 3;
}
const { ids, numbered = false, group = false, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const items = ids.map((id, i) => ({ n: i + 1, s: source(id) }));
const groups = group
  ? ORIGIN_ORDER.map((o) => ({ origin: o, items: items.filter((x) => x.s.origin === o) })).filter((g) => g.items.length)
  : [{ origin: null, items }];
---
{groups.map((g) => (
  <>
    {g.origin && <H id={`origin-${g.origin}`}>{ORIGIN_LABEL[g.origin]} ({g.items.length})</H>}
    <ol class={numbered ? 'source-group numbered' : 'source-group'}>
      {g.items.map(({ n, s }) => (
        <li id={`src-${s.id}`} value={numbered ? n : undefined}>
          <a class="s-title" href={s.url} rel="noopener">{s.title}</a>
          {!group && <span class="origin">{ORIGIN_LABEL[s.origin]}</span>}
          <span class="s-meta">
            {s.publisher}. {s.date === 'n.d.' ? 'Undated' : `Dated ${s.date}`}. Figures last checked {s.checked}.
          </span>
        </li>
      ))}
    </ol>
  </>
))}
