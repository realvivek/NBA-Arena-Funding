---
import Prose from './Prose.astro';
import Chart from './Chart.astro';
import Teams from './Teams.astro';
import Cites from './Cites.astro';
import type { Prepared } from '../lib/prepare';
interface Props {
  blocks: Prepared[];
}
const { blocks } = Astro.props;
---
{blocks.map((b) =>
  b.kind === 'p' ? <Prose html={b.html} sources={b.sources} numbers={b.numbers} /> :
  b.kind === 'fig' ? <Chart id={b.id} numbers={b.numbers} /> :
  b.kind === 'scrolly' ? <Chart id={b.id} numbers={b.numbers} steps={b.steps} /> :
  b.kind === 'quote' ? (
    <blockquote class="pullquote">
      <p set:html={b.html} />
      <footer>{b.by} <Cites ids={b.sources} numbers={b.numbers} /></footer>
    </blockquote>
  ) :
  b.kind === 'teams' ? <Teams title={b.title} intro={b.intro} sources={b.sources} numbers={b.numbers} /> :
  <h2>{b.text}</h2>
)}
