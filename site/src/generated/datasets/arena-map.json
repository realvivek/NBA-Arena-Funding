 "note": "Locations from each arena's Wikipedia article; money from the ledger.",
 "method": "select a.team, a.arena, a.city, c.lat, c.lon, m.public_2026_m, 100 * m.public_2026_m / m.spending_2026_m as public_share_pct, coalesce((select list(s.source_id order by s.ord) from coord_sources s where s.team = a.team), []) as sources from arenas a join coords c using (team) join (select team, sum(public_2026_m) public_2026_m, sum(spending_2026_m) spending_2026_m from items where core group by team) m using (team) order by m.public_2026_m desc, a.team"
