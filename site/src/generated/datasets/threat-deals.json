 "method": "select d.id, d.deal, case d.grp when 'T' then 'threat' else 'no_threat' end as grp, d.flags, d.year, d.public_m, d.public_m_2025 * (select factor_2026 from cpi where year = 2025) as public_2026_m, d.total_m, 100 * d.share as share_pct from threat_deals d order by d.grp desc, d.year, d.id"
