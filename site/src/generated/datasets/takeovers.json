 "note": "",
 "method": "with t as (select distinct i.team from items i join arenas a using (team) where a.built_privately_majority = 'Y' and i.kind in ('renovation', 'purchase') and (i.core or i.status = 'pending') and i.public_2026_m > 0) select i.team, a.arena, cast(a.opened as integer) as opened, i.item_id, i.kind, i.description, i.year, i.status, i.core, i.public_2026_m, case when i.kind = 'purchase' then 0 else greatest(i.spending_2026_m - i.public_2026_m, 0) end as private_2026_m, coalesce((select list(s.source_id order by s.role desc, s.ord) from item_sources s where s.item_id = i.item_id), []) as sources from items i join t using (team) join arenas a using (team) where i.kind in ('construction', 'purchase', 'renovation') and (i.core or i.status = 'pending') order by i.team, i.year, i.item_id"
}
