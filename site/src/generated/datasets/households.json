 "method": "select h.team, h.deal, h.amount_2026_m, h.geo_id, h.jurisdiction, h.households, h.share, h.per_household_2026, h.note, coalesce((select list(s.source_id order by s.item_id, s.ord) from item_sources s where s.team = h.team and s.role = 'public' and s.item_id not like '%-ongoing-%'), []) as sources from households h order by h.per_household_2026 desc, h.team, h.geo_id"
