 ],
 "note": "One row per arena and tax line; the arena's resident-paid capital money (general funds, dedicated sales taxes, tax increment and tax capture, lease-revenue bonds, alcohol and tobacco taxes) in 2026 dollars. poorest_share and top1_share are the shares of family income the matching ITEP line takes in that state from the lowest 20% and the top 1% of households (2024 tax law at 2023 incomes, households under 65); ratio divides the first by the second. The line describes how the kind of tax falls across a state, not the arena tax alone.",
 "method": "select i.team, regexp_replace(a.city, ', [A-Z]{2}$', '') as city, i.state, i.line, case i.line when 'SE_GST' then 'sales tax' when 'SE_EXCISE' then 'alcohol and tobacco taxes' when 'PROP_TOTAL' then 'property-tax increment' else 'general taxes' end as kind, any_value(i.line_name) as line_name, sum(i.public_2026_m) as public_2026_m, any_value(i.poorest_share) as poorest_share, any_value(i.top1_share) as top1_share, any_value(i.ratio) as ratio, (select list_sort(coalesce(list(distinct s.source_id), [])) from item_sources s join buckets b on b.item_id = s.item_id join itep_lines l on l.team = b.team and l.bucket = b.bucket join capital c on c.item_id = b.item_id where s.team = i.team and s.role = 'public' and l.line = i.line) as sources from incidence i join arenas a using (team) group by i.team, a.city, i.state, i.line order by ratio desc, public_2026_m desc"
}
