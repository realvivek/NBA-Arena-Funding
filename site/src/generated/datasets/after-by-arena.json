 "note": "After opening means renovations, purchases, yearly payments and property-tax breaks; building money includes Barclays Center's PILOT bonds, as in the bill. more_after marks arenas where the public has paid more since opening than it did to build them.",
 "method": "select a.team, a.renovation, a.purchase, a.ongoing, a.tax_breaks, a.after_2026_m, a.owed_2026_m, a.build_2026_m, a.more_after, coalesce((select list(distinct s.source_id order by s.source_id) from item_sources s where s.role = 'public' and s.item_id in (select item_id from after_items x where x.team = a.team)), []) || coalesce((select list(distinct s.source_id order by s.source_id) from arena_sources s where s.row_type = 'current_arena' and s.team = a.team and s.field = 'tax_break_source' and a.tax_breaks > 0), []) as sources from after_by_arena a order by a.after_2026_m desc"
}
