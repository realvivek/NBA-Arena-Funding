 ],
 "note": "For a deal paid by several governments, a household in the most local one (city or county) also pays its share of the larger ones, so the amounts add. Assumes each smaller jurisdiction lies inside the larger ones. visitors_share, shared_share and sales_share are the shares of the deal's capital money from hotel and car-rental taxes, from meal and ticket taxes, and from dedicated sales taxes; pending_2026_m is pending money included in the deal (Portland).",
 "method": "with h as ( -- the District of Columbia is a city as well as a state-level government, so it counts as local select *, case when geo_id = '04000US11' then 1 else case substr(geo_id, 1, 3) when '160' then 1 when '050' then 2 else 3 end end as level from households), -- who mostly pays the capital money behind each deal (counted, project and pending items), for the marks pay as ( select i.team, sum(b.public_2026_m) filter (where g.payer = 'visitors') / sum(b.public_2026_m) as visitors_share, sum(b.public_2026_m) filter (where g.payer = 'shared') / sum(b.public_2026_m) as shared_share, sum(b.public_2026_m) filter (where b.bucket = 'sales') / sum(b.public_2026_m) as sales_share from buckets b join items i using (item_id) join bucket_groups g using (bucket) where i.kind <> 'ongoing' and not (i.kind = 'project' and i.description ilike '%district%') group by i.team) select team, any_value(deal) as deal, arg_min(jurisdiction, level) as jurisdiction, sum(per_household_2026) as per_household_2026, max(pending_2026_m) as pending_2026_m, coalesce(any_value(p.visitors_share), 0) as visitors_share, coalesce(any_value(p.shared_share), 0) as shared_share, coalesce(any_value(p.sales_share), 0) as sales_share, list({'jurisdiction': jurisdiction, 'level': level, 'per_household_2026': per_household_2026, 'households': households, 'share': share} order by level) as parts, (select coalesce(list(s.source_id order by s.item_id, s.ord), []) from item_sources s where s.team = h.team and s.role = 'public' and s.item_id not like '%-ongoing-%') as sources from h left join pay p using (team) group by team order by per_household_2026 desc, team"
}
