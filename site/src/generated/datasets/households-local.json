 ],
 "note": "For a deal paid by several governments, a household in the most local one (city or county) also pays its share of the larger ones, so the amounts add. Assumes each smaller jurisdiction lies inside the larger ones.",
 "method": "with h as ( select *, case substr(geo_id, 1, 3) when '160' then 1 when '050' then 2 else 3 end as level from households) select team, any_value(deal) as deal, arg_min(jurisdiction, level) as jurisdiction, sum(per_household_2026) as per_household_2026, list({'jurisdiction': jurisdiction, 'level': level, 'per_household_2026': per_household_2026, 'households': households, 'share': share} order by level) as parts, (select coalesce(list(s.source_id order by s.item_id, s.ord), []) from item_sources s where s.team = h.team and s.role = 'public' and s.item_id not like '%-ongoing-%') as sources from h group by team order by per_household_2026 desc, team"
}
