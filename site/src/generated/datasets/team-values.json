 "note": "Prices are what the current controlling owner paid, or the valuation at which a controlling stake changed hands, in the year paid and in 2026 dollars; prices that bought more or less than the team are marked by price_scope. Values are Forbes's of October 2026 and 2025 and Sportico's of October 2026. Public money is the ledger's, with tax breaks shown separately.",
 "method": "with pub as (select team, sum(public_2026_m) filter (where core) as public_2026_m from items where kind <> 'project' group by team), brk as (select team, coalesce(pilot_2026_m, 0) + case when tax_break_in_expanded_total = 'Y' then tax_break_cumulative_2026_m else 0 end as tax_breaks_2026_m from arenas) select v.team, v.owner, v.control_year, v.price_year, v.price_m, v.price_scope, v.price_note, v.price_label, v.price_m * (select factor_2026 from cpi where cpi.year = v.price_year) as price_2026_m, v.seller_price_m, v.seller_year, v.forbes_2025_b, v.forbes_2026_b, v.sportico_2026_b, v.value_label, v.deal, v.deal_value_b, v.deal_date, v.deal_label, v.note, coalesce(p.public_2026_m, 0) as public_2026_m, coalesce(b.tax_breaks_2026_m, 0) as tax_breaks_2026_m, coalesce((select list(s.source_id order by case s.field when 'price' then 1 when 'value' then 2 else 3 end, s.ord) from value_sources s where s.team = v.team), []) as sources from team_values v left join pub p using (team) left join brk b using (team) order by v.forbes_2026_b desc, v.team"
