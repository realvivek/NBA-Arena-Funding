 ],
 "note": "Main source of wealth from Forbes profiles read Oct. 17-18, 2026, or the release or report named, classed by this project as private equity (private equity or hedge funds), other finance (mortgage lending, asset management, venture capital, financial services) or other. Funds are those with a current stake in the team or its parent company; stakes seen only in search results are left out.",
 "method": "with pub as (select team, sum(public_2026_m) filter (where core) as public_2026_m from items where kind <> 'project' group by team), brk as (select team, coalesce(pilot_2026_m, 0) + case when tax_break_in_expanded_total = 'Y' then tax_break_cumulative_2026_m else 0 end as tax_breaks_2026_m from arenas), f as (select team, list(fund order by fund) as funds, list(stake order by fund) as stakes from investors where status = 'current' group by team) select v.team, v.owner, v.owner_wealth, v.owner_field, v.owner_class, v.control_year, coalesce(f.funds, []) as funds, coalesce(f.stakes, []) as stakes, v.forbes_2026_b, coalesce(p.public_2026_m, 0) + coalesce(b.tax_breaks_2026_m, 0) as public_2026_m, list_concat(coalesce((select list(s.source_id order by s.ord) from value_sources s where s.team = v.team and s.field = 'owner'), []), coalesce((select list(s.source_id order by s.fund, s.ord) from investor_sources s where s.team = v.team and s.fund in (select fund from investors i where i.team = v.team and i.status = 'current')), [])) as sources from team_values v left join f using (team) left join pub p using (team) left join brk b using (team) order by case v.owner_class when 'private_equity' then 1 when 'other_finance' then 2 else 3 end, len(coalesce(f.funds, [])) = 0, v.team"
}
